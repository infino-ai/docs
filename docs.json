{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Infino",
  "logo": {
    "light": "/logo/infino-logo.png",
    "dark": "/logo/infino-logo.png"
  },
  "favicon": "/favicon.png",
  "description": "Infino is an open-source retrieval engine for full-text, vector, and SQL search, with your data stored as Apache Parquet on object storage.",
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.infino.ai",
      "og:site_name": "Infino",
      "og:type": "website",
      "og:image": "/images/og-card.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "/images/og-card.png"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search the Infino docs…"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "colors": {
    "primary": "#d24011",
    "light": "#e8623a",
    "dark": "#d24011"
  },
  "fonts": {
    "family": "Inter"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "how-it-works",
              "concepts/object-storage-native-retrieval"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/tables",
              "guides/embeddings",
              "guides/indexing",
              {
                "group": "Search",
                "pages": [
                  "guides/search/overview",
                  "guides/search/full-text",
                  "guides/search/vector",
                  "guides/search/hybrid"
                ]
              },
              "guides/storage",
              "guides/parquet-interop"
            ]
          },
          {
            "group": "Reference",
            "pages": ["sql-reference", "faq", "tradeoffs", "troubleshooting"]
          }
        ]
      },
      {
        "tab": "Integrations",
        "pages": [
          "integrations/index",
          "integrations/langchain",
          "integrations/ai-sdk",
          "integrations/crewai",
          "integrations/mcp"
        ]
      },
      {
        "tab": "Tutorials",
        "pages": ["tutorials/index"]
      },
      {
        "tab": "API Reference",
        "pages": ["api-reference/index"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/infino-ai/infino"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/infino-ai/infino"
    }
  }
}
