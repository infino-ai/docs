{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Infino",
  "logo": {
    "light": "/logo/infino-logo.png",
    "dark": "/logo/infino-logo.png",
    "href": "https://infino.ai"
  },
  "favicon": "/favicon.png",
  "description": "Infino is an open-source retrieval engine for full-text, vector, and SQL search, with your data stored as Apache Parquet on object storage.",
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://infino.ai/docs",
      "og:site_name": "Infino",
      "og:type": "website",
      "og:image": "/images/og-card.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "/images/og-card.png"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search the Infino docs…"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "colors": {
    "primary": "#d24011",
    "light": "#e8623a",
    "dark": "#d24011"
  },
  "fonts": {
    "family": "Inter"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "core-concepts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/storage",
              "guides/tables",
              "guides/embeddings",
              "guides/indexing",
              "guides/search",
              "guides/hybrid-search-on-parquet",
              "guides/parquet-interop"
            ]
          },
          {
            "group": "Infino Cloud",
            "pages": [
              "cloud/index",
              "cloud/quickstart",
              "cloud/authentication",
              "cloud/architecture",
              "cloud/errors",
              "cloud/limits",
              "cloud/faq"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "sql-reference",
              "faq",
              "tradeoffs",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "pages": [
          "integrations/mcp"
        ]
      },
      {
        "tab": "Tutorials",
        "pages": [
          "tutorials/index"
        ]
      },
      {
        "tab": "Use Cases",
        "pages": [
          "use-cases/index",
          "use-cases/agent-memory"
        ]
      },
      {
        "tab": "Demos",
        "pages": [
          "demos/index",
          "demos/lantern"
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "SDKs & CLI",
            "pages": [
              "api-reference/index",
              "api-reference/parity",
              "cli"
            ]
          },
          {
            "group": "REST API",
            "openapi": "/api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://infino.ai"
      },
      {
        "label": "Compare",
        "href": "https://infino.ai/vs"
      },
      {
        "label": "Infino Cloud",
        "href": "https://infino.ai/cloud"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/infino-ai/infino"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Talk to us",
      "href": "mailto:info@infino.ai"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/infino-ai/infino"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/infino-ai/infino"
          },
          {
            "label": "Issues",
            "href": "https://github.com/infino-ai/infino/issues"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/core-concepts"
    },
    {
      "source": "/concepts/object-storage-native-retrieval",
      "destination": "/core-concepts"
    },
    {
      "source": "/concepts/efficiency-and-cost",
      "destination": "/core-concepts"
    },
    {
      "source": "/concepts/freshness",
      "destination": "/core-concepts"
    },
    {
      "source": "/guides/search/overview",
      "destination": "/guides/search"
    },
    {
      "source": "/guides/search/full-text",
      "destination": "/guides/search#full-text-bm25"
    },
    {
      "source": "/guides/search/vector",
      "destination": "/guides/search#vector-search"
    },
    {
      "source": "/guides/search/hybrid",
      "destination": "/guides/search#hybrid-search"
    },
    {
      "source": "/integrations",
      "destination": "/integrations/mcp"
    },
    {
      "source": "/integrations/langchain",
      "destination": "/integrations/mcp"
    },
    {
      "source": "/integrations/ai-sdk",
      "destination": "/integrations/mcp"
    },
    {
      "source": "/integrations/crewai",
      "destination": "/integrations/mcp"
    }
  ]
}